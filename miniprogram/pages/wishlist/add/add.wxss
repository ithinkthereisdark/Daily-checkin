.page {
  padding: 30rpx;
  background: #FFF5EC;
  min-height: 100vh;
  box-sizing: border-box;
}

.form {
  background: #FFFBF7;
  border-radius: 22rpx;
  padding: 30rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(180,140,120,0.06);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #8D7B72;
  margin-bottom: 12rpx;
}

.title-input {
  width: 100%;
  height: 80rpx;
  background: #FFFBF7;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #5D4037;
  border: 2rpx solid #F0E8E0;
}

.desc-input {
  width: 100%;
  min-height: 180rpx;
  background: #FFFBF7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #5D4037;
  border: 2rpx solid #F0E8E0;
}

/* ====== Image Grid（detail 页同款）====== */

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F5F0EB;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D7CCC8;
  background: #FFFBF7;
}

.add-icon {
  font-size: 52rpx;
  color: #BCAAA4;
  line-height: 1;
  margin-bottom: 4rpx;
}

.add-label {
  font-size: 20rpx;
  color: #A1887F;
}

.img-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D7CCC8;
  background: #FFFBF7;
  font-size: 28rpx;
  color: #8D7B72;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}

.btn-group button {
  flex: 1;
  margin: 0;
}

/* 心愿删除按钮：与保存修改并排（编辑模式）。
   注意：类名不能用 .delete-btn——与图片删除小圆钮同名会导致样式互相污染 */
.delete-wish-btn {
  background: #F5F0EB;
  color: #C62828;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
