.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFF5EC;
}

.list {
  flex: 1;
  height: 0;
  padding: 20rpx;
  box-sizing: border-box;
}

.list-bottom {
  height: 40rpx;
}

/* ====== 顶部统计卡 ====== */

.stats-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #FFFBF7;
  border-radius: 22rpx;
  box-shadow: 0 2rpx 14rpx rgba(180,140,120,0.06);
  padding: 28rpx 8rpx;
  margin-bottom: 32rpx;
}

/* 手动刷新按钮（统计卡右上角） */
.refresh-btn {
  position: absolute;
  top: -6rpx;
  right: 14rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF2EC;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.refresh-btn-hover {
  background: #FBE3D3;
}

.refresh-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8905C;
}

.refresh-btn.spinning .refresh-icon {
  animation: refreshSpin 0.8s linear infinite;
}

@keyframes refreshSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #E8905C;
  line-height: 1.1;
}

.stat-label {
  font-size: 22rpx;
  color: #8D7B72;
}

.stat-sep {
  width: 1rpx;
  height: 44rpx;
  background: #F0E8E0;
  flex-shrink: 0;
}

/* ====== Section ====== */

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 8rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4037;
}

.header-count {
  font-size: 22rpx;
  color: #BCAAA4;
  background: #F5F0EB;
  border-radius: 18rpx;
  padding: 2rpx 16rpx;
  font-weight: 600;
}

/* ====== 通用小按钮（view 模拟，避免 button 默认样式）====== */

.w-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.w-btn.primary {
  background: #E8905C;
  color: #fff;
}

.w-btn.ghost {
  background: #F5F0EB;
  color: #8D7B72;
}

.w-btn.small {
  font-size: 26rpx;
  padding: 10rpx 26rpx;
}

.w-btn:not(.small) {
  font-size: 28rpx;
  padding: 14rpx 32rpx;
}

.w-btn.disabled {
  background: #F5F0EB;
  color: #BCAAA4;
}

/* ====== 核销单卡片（进行中）====== */

.red-card {
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 14rpx rgba(180,140,120,0.06);
  margin-bottom: 16rpx;
}

.red-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.red-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.red-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.red-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.red-points {
  font-size: 28rpx;
  font-weight: 600;
}

.positive { color: #2E7D32; }
.negative { color: #C62828; }

/* 状态 tag */
.status-tag {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 22rpx;
  margin-left: 12rpx;
}

.status-tag.pending { background: #FFF2EC; color: #E8905C; }
.status-tag.shipped { background: #E8F0FA; color: #3F6FB5; }
.status-tag.received { background: #E8F5E9; color: #2E7D32; }
.status-tag.cancelled { background: #F5F0EB; color: #8D7B72; }

/* 凭证码 */
.code-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #FFF5EC;
  border: 2rpx dashed #E8CBB5;
  border-radius: 14rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.code-label {
  font-size: 24rpx;
  color: #8D7B72;
}

.code-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #E8905C;
  letter-spacing: 3rpx;
}

.red-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

/* ====== 分区空态占位 ====== */

.section-empty {
  background: #FFFBF7;
  border: 2rpx dashed #E8D5C5;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #BCAAA4;
  margin-bottom: 16rpx;
}

/* ====== 心愿卡片 ====== */

.wish-card {
  display: flex;
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 2rpx 14rpx rgba(180,140,120,0.06);
  margin-bottom: 16rpx;
}

.wish-card-hover {
  background: #FFF5EC;
}

.wish-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.wish-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.wish-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

/* 心愿状态 tag（待定价 / 待核销） */
.wish-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.wish-status.pricing { background: #FFF2EC; color: #E8905C; }
.wish-status.ready { background: #E8F0FA; color: #3F6FB5; }

.wish-desc {
  font-size: 26rpx;
  color: #BCAAA4;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.points-hint {
  font-size: 26rpx;
  color: #8D7B72;
  font-weight: 500;
}

.wish-actions {
  display: flex;
  gap: 12rpx;
}

/* ====== 历史 ====== */

.his-card {
  background: #FFFBF7;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(180,140,120,0.06);
}

.his-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.his-row:last-child {
  border-bottom: none;
}

.his-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.his-title-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.his-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
  min-width: 0;
}

/* 提出者名字：小一号、淡色 */
.his-owner {
  font-size: 22rpx;
  color: #BCAAA4;
  flex-shrink: 0;
  white-space: nowrap;
}

.his-meta {
  font-size: 22rpx;
  color: #BCAAA4;
}

.his-points {
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ====== 空态 / 加载 ====== */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.empty-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #BCAAA4;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #C9BFB5;
  margin-top: 8rpx;
  display: block;
  margin-bottom: 32rpx;
}

.add-btn {
  padding: 16rpx 44rpx;
  font-size: 28rpx;
}

.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #BCAAA4;
}

/* ====== 核销成功凭证弹层 ====== */

.redeem-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.redeem-box {
  background: #FFFBF7;
  border-radius: 24rpx;
  padding: 48rpx 48rpx 40rpx;
  width: 520rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.redeem-emoji {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.redeem-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 32rpx;
}

.redeem-code-label {
  font-size: 24rpx;
  color: #8D7B72;
  margin-bottom: 10rpx;
}

.redeem-code {
  font-size: 44rpx;
  font-weight: 700;
  color: #E8905C;
  letter-spacing: 4rpx;
  background: #FFF2EC;
  border-radius: 16rpx;
  padding: 14rpx 36rpx;
  margin-bottom: 26rpx;
}

.redeem-points {
  font-size: 28rpx;
  font-weight: 600;
  color: #C62828;
  margin-bottom: 8rpx;
}

.redeem-hint {
  font-size: 24rpx;
  color: #BCAAA4;
  margin-bottom: 36rpx;
}

.redeem-btn {
  background: #E8905C;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 64rpx;
  border-radius: 16rpx;
}

.redeem-btn:active {
  opacity: 0.85;
}
